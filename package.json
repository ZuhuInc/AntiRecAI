{
  "name": "antirecai",
  "version": "1.0.3",
  "description": "Stealth OBS-Excluded AI Overlay with 1-Click Screen Snip & Solve",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win nsis portable"
  },
  "keywords": [
    "electron",
    "gemini",
    "chatgpt",
    "claude",
    "obs-protection",
    "screen-capture-exclusion",
    "overlay"
  ],
  "author": "AntiRecAI",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.2.1",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.antirecai.overlay",
    "productName": "AntiRecAI",
    "publish": {
      "provider": "github",
      "owner": "ZuhuInc",
      "repo": "AntiRecAI"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/screenshot-desktop/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/IconMain.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AntiRecAI"
    },
    "portable": {
      "artifactName": "AntiRecAI-Portable-${version}.${ext}"
    }
  }
}
